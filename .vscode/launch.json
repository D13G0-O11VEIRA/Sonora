{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sonora (interface gráfica)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Sonora (terminal — pergunta o link)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["${input:link}"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Testes (unittest)",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-v"],
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "link",
      "type": "promptString",
      "description": "Cole o link do YouTube/Spotify (ou 'Artista - Música')"
    }
  ]
}
